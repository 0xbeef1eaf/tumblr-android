# All optional. Normally each user enters their own Tumblr app's consumer key and secret in
# Settings -> Tumblr API (stored in SecureStore). These only pre-configure a build you
# distribute; values entered in Settings always win.
#
# Built-in OAuth consumer key from https://www.tumblr.com/oauth/apps (guest browsing)
EXPO_PUBLIC_TUMBLR_API_KEY=
# Token-exchange proxy that adds the secret, e.g. https://<worker>.workers.dev/token (see proxy/)
EXPO_PUBLIC_TOKEN_EXCHANGE_URL=
# Development builds only: direct token exchange with the built-in key. Release builds ignore
# it; never set it in an EAS profile you distribute.
EXPO_PUBLIC_TUMBLR_CLIENT_SECRET=
# Forks only: the OAuth callback URL registered as your Tumblr app's "Default callback URL"
# (must be https://; nothing is served there, the in-app WebView intercepts it).
EXPO_PUBLIC_OAUTH_REDIRECT_URI=
