# OAuth consumer key from https://www.tumblr.com/oauth/apps (public by design)
EXPO_PUBLIC_TUMBLR_API_KEY=
# Token-exchange proxy, e.g. https://<worker>.workers.dev/token (see proxy/)
EXPO_PUBLIC_TOKEN_EXCHANGE_URL=
# Dev builds only: lets the app exchange tokens directly. Never set in EAS production.
EXPO_PUBLIC_TUMBLR_CLIENT_SECRET=
