#!/bin/sh
# Last line of defence (also catches `git commit --no-verify`): every commit about to be pushed
# must be authored and committed by the project identity, carry no foreign trailers and add no
# deny-listed text. Also refuses to push anywhere but github.com/0xbeef1eaf/*.
set -eu
. "$(dirname "$0")/identity.sh"
in_ci && exit 0

url=$2
case "$url" in
  https://github.com/0xbeef1eaf/* | git@github.com:0xbeef1eaf/* | ssh://git@github.com/0xbeef1eaf/*) ;;
  *) fail "Refusing to push to $url (this repo only pushes to github.com/0xbeef1eaf/*)." ;;
esac

zero=0000000000000000000000000000000000000000
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # branch deletion
  if [ "$remote_sha" = "$zero" ]; then
    # New ref: only the commits the remote does not already have.
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi
  # shellcheck disable=SC2086
  for sha in $(git rev-list $range); do
    short=$(git rev-parse --short "$sha")
    who=$(git log -1 --format='%an <%ae>|%cn <%ce>' "$sha")
    expected="$ALLOWED_NAME <$ALLOWED_EMAIL>"
    if [ "$who" != "$expected|$expected" ]; then
      printf '\033[31m✖ %s has author/committer %s\033[0m\n' "$short" "$who" >&2
      status=1
    fi
    if git log -1 --format=%B "$sha" | grep -q -i -E "$FOREIGN_TRAILERS"; then
      printf '\033[31m✖ %s has a Co-Authored-By / Claude-Session / Signed-off-by trailer\033[0m\n' "$short" >&2
      status=1
    fi
    hits=$({
      git log -1 --format=%B "$sha"
      git show --format= --no-color -U0 "$sha" | grep '^+' | grep -v '^+++' || true
    } | denylist_hits)
    if [ -n "$hits" ]; then
      printf '\033[31m✖ %s contains deny-listed text: %s\033[0m\n' "$short" "$(echo $hits)" >&2
      status=1
    fi
  done
done

if [ "$status" -ne 0 ]; then
  fail "Push blocked. Fix the commits above, e.g.:" \
    "git rebase -r <base> --exec 'git commit --amend --no-edit --reset-author'"
fi
