#!/bin/sh
# Strip trailers that credit another identity (Co-Authored-By, Claude-Session, Signed-off-by),
# then reject messages containing deny-listed text (see identity.sh).
set -eu
. "$(dirname "$0")/identity.sh"
in_ci && exit 0

msg=$1
tmp="$msg.identity.$$"
grep -v -i -E "$FOREIGN_TRAILERS" "$msg" >"$tmp" || true
# Drop the blank lines the removed trailers leave at the end.
sed -e ':a' -e '/^[[:space:]]*$/{$d;N;ba' -e '}' "$tmp" >"$msg"
rm -f "$tmp"

hits=$(grep -v '^#' "$msg" | denylist_hits)
[ -z "$hits" ] || fail "Commit message contains deny-listed text:" $hits
